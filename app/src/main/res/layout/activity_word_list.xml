<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/PD.Title" android:text="@string/word_list_title" />
    <TextView style="@style/PD.Body" android:text="@string/word_list_help" />

    <EditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="@string/word_list_title"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/resetButton" style="@style/PD.Button"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/reset_default" />
        <Button android:id="@+id/saveButton" style="@style/PD.Button"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
